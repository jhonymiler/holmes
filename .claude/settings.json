{
  "hooks": {
    "SessionStart": [
      {"matcher": "startup|resume|clear|compact", "hooks": [
        {"type": "command", "command": "python3 -I \"$CLAUDE_PROJECT_DIR/holmes/hooks.py\" abertura", "timeout": 30,
         "statusMessage": "holmes: mapa do caso..."}]}
    ],
    "UserPromptSubmit": [
      {"hooks": [
        {"type": "command", "command": "python3 -I \"$CLAUDE_PROJECT_DIR/holmes/hooks.py\" pistas", "timeout": 20}]}
    ],
    "PreToolUse": [
      {"matcher": "Bash", "hooks": [
        {"type": "command", "command": "python3 -I \"$CLAUDE_PROJECT_DIR/holmes/hooks.py\" guarda", "timeout": 10}]}
    ],
    "PostToolUse": [
      {"matcher": "Bash", "hooks": [
        {"type": "command", "command": "python3 -I \"$CLAUDE_PROJECT_DIR/holmes/hooks.py\" pos", "timeout": 10}]}
    ],
    "Stop": [
      {"hooks": [
        {"type": "command", "command": "python3 -I \"$CLAUDE_PROJECT_DIR/holmes/hooks.py\" fim", "timeout": 20}]}
    ],
    "PreCompact": [
      {"hooks": [
        {"type": "command", "command": "python3 -I \"$CLAUDE_PROJECT_DIR/holmes/hooks.py\" pre-compact", "timeout": 30}]}
    ]
  }
}
